---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---

<Base
  title="Public projects"
  description="Planned public projects by Louis Gimeno: AWS infrastructure with Terraform, Kubernetes deployment and reliability, and a CI/CD pipeline."
  path="/projects/"
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Projects</p>
      <h1>Public projects</h1>
      <p class="lede">
        Three connected personal projects tell one story: provision infrastructure, deploy a workload, then automate and
        validate delivery. They use sample applications, not client work.
      </p>
      <div class="callout callout--warn" role="note">
        <p>
          <strong>Status:</strong> all three are planned and none has been built yet. A project is marked In Progress or
          Complete, and linked to a repository, only once the work exists and has been tested.
        </p>
      </div>
      <div class="grid grid--3">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>
</Base>
