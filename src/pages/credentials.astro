---
import Base from '../layouts/Base.astro';
import { credentials, education } from '../data/credentials';
---

<Base
  title="Certifications and education"
  description="Cloud and DevOps certifications held by Louis Gimeno, including AWS, Google Cloud, Azure, HashiCorp Terraform, and HCL, plus a BS in Computer Science."
  path="/credentials/"
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Credentials</p>
      <h1>Certifications and education</h1>

      <h2 style="margin-top:2rem">Certifications</h2>
      <ul class="cred-list">
        {
          credentials.map((c) => (
            <li>
              <span>
                {c.verifyUrl ? <a href={c.verifyUrl} rel="noopener">{c.name}</a> : c.name}
                <span class="cred-list__issuer">{c.issuer}</span>
              </span>
              <span class="cred-list__date">{c.date}</span>
            </li>
          ))
        }
      </ul>

      <h2 style="margin-top:3rem">Education</h2>
      <h3>{education.school}</h3>
      <p>{education.degree}</p>
      <ul>
        {education.highlights.map((h) => <li>{h}</li>)}
      </ul>
    </div>
  </section>
</Base>
