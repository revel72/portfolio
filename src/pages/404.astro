---
import Base from '../layouts/Base.astro';
import { href } from '../lib/url';
---

<Base title="Page not found" description="The page you requested could not be found." path="/404/" noindex>
  <section class="section">
    <div class="container prose">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p class="lede">That page doesn't exist or has moved.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={href('/')}>Go to the homepage</a>
        <a class="btn btn--secondary" href={href('/case-studies/')}>View case studies</a>
      </div>
    </div>
  </section>
</Base>
