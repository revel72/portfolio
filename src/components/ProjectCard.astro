---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const planned = project.status === 'Planned';
---

<article class="card">
  <span class={`badge ${planned ? 'badge--planned' : ''}`}>
    Project {project.step} &middot; {project.status}
  </span>
  <h3>{project.title}</h3>
  <p>{project.objective}</p>
  <p class="muted"><strong>Planned scope</strong></p>
  <ul>
    {project.scope.map((s) => <li>{s}</li>)}
  </ul>
  {
    project.repoUrl ? (
      <p><a href={project.repoUrl} rel="noopener">View repository</a></p>
    ) : (
      <p class="muted">No public repository yet. A link will be added when the work exists.</p>
    )
  }
  {project.writeupUrl && <p><a href={project.writeupUrl}>Read the write-up</a></p>}
</article>
